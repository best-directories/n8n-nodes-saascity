{
	"name": "n8n-nodes-saascity",
	"version": "0.1.0",
	"description": "n8n nodes for SaaSCity: manage your listings, react to upvotes and search the SaaSCity launch directory.",
	"license": "MIT",
	"homepage": "https://github.com/nyyhao/n8n-nodes-saascity#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"saascity",
		"product-launch",
		"startup-directory"
	],
	"author": {
		"name": "SaaSCity",
		"email": "support@saascity.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nyyhao/n8n-nodes-saascity.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SaasCityApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SaasCity/SaasCity.node.js",
			"dist/nodes/SaasCityTrigger/SaasCityTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.55.5",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
